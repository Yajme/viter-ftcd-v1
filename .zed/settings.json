// Folder-specific settings
//
// For a full list of overridable settings, and general information on folder-specific settings,
// see the documentation: https://zed.dev/docs/configuring-zed#settings-files
{
  "languages": {
    "TypeScript": {
      "language_servers": ["vtsls", "eslint", "!typescript-language-server"],
    },
    "TSX": { "language_servers": ["vtsls", "eslint"] },
    "JavaScript": { "language_servers": ["vtsls", "eslint"] },
    "JSON": { "language_servers": ["json-language-server"] },
    "PHP": {
      "language_servers": ["phpactor", "!vtsls"],
      "format_on_save": "on",
      "formatter": {
        "external": {
          "command": "/home/ecari/.local/bin/pretty-php",
          "arguments": ["--stdin-filepath", "{buffer_path}"],
        },
      },
    },
  },
}
